#!/bin/bash

set -e

function getJsonValue() {
  KEY=$1
  num=$2
  awk -F"[,:}]" '{for(i=1;i<=NF;i++){if($i~/'"${KEY}"'\042/){print $(i+1)}}}' | tr -d '"' | sed -n "${num}"p
}

tag="${1}"
bump="${2}"
branch="${BRANCH}"
currentVersion=$(cat ./lerna.json | getJsonValue 'version' |  cut -f1 -d"-")
semver=( ${currentVersion//./ } )
major="${semver[0]}"
minor="${semver[1]}"
patch=$((semver[2] + 1))
id=$(date '+%Y%m%d%H%M')
alphaVersion="${major}.${minor}.${patch}-${tag}.$(date '+%Y%m%d')"

# Verify arguments
if [ -z "${tag}" ] ; then
  echo "tag cannot be empty"
  exit 1
fi
if [ "${tag}" != "rc" ] && [ "${tag}" != "beta" ] && [ "${tag}" != "alpha" ] && [ "${tag}" != "public" ] && [ "${tag}" != "dev" ] ; then
  echo "tag must be one of rc, beta, alpha, public, dev"
  exit 1
fi
if [ -z "${bump}" ] ; then
  bump="patch";
fi
if [ "${bump}" != "patch" ] && [ "${bump}" != "minor" ] && [ "${bump}" != "major" ] && [[ ! "${bump}" =~ ^${alphaVersion}* ]] ; then
  echo "bump must be one of patch, minor, major, or exact version of format[major.minor.patch-tag]"
  exit 1
fi

# Verify tag and branch
if [ "${tag}" == "public" ] && [ "${branch}" != "main" ] ; then
  echo "Public release must be done on the main branch"
  exit 1
fi
if [ "${tag}" == "beta" ] && [[ ! "${branch}" =~ ^v.-beta$ ]] ; then
  echo "Beta release must be done on the v*-beta branch"
  exit 1
fi

# Update bump level
if [ "${tag}" != "public" ] && [[ ! "${bump}" =~ ^${alphaVersion}* ]] ; then
  bump="pre${bump}"
fi

# alpha/dev get a timestamp in their version
if [[ "${tag}" == "dev"  ||  "${tag}" == "alpha" ]] && [[ ! "${bump}" =~ ^${alphaVersion}* ]] ; then
  bump="${major}.${minor}.${patch}-${tag}.${id}"
fi

# Publishing
echo -e "\n------------------------------------"
echo -e "-- Publishing as \033[1m${tag}\033[0m :: \033[1m${bump}\033[0m release --"
echo -e "-- Publishing as \033[1m${tag}\033[0m :: \033[1m${bump}\033[0m release --"
echo -e "------------------------------------\n"

#
# Versioning and publishing are two separate steps here.
#
# `lerna version` only rewrites the package.json files (and tags, for a public
# release). The upload is then done by the npm CLI, because npm trusted
# publishing (OIDC) lives in the CLI: it exchanges the workflow's id-token for a
# short-lived, package-scoped registry token. lerna cannot do that — it uploads
# through its bundled libnpmpublish@6, which predates OIDC and only knows how to
# read an _authToken. Running `lerna publish` here would need NODE_AUTH_TOKEN.
#
# `lerna exec` walks the packages in topological order, so a dependency is
# always published before the packages that depend on it.
#

if [ "${tag}" == "public" ] ; then
  ./node_modules/.bin/lerna version \
    --force-publish="*" \
    --no-push \
    --exact \
    --yes \
    "${bump}"
  distTag="latest"
else
  ./node_modules/.bin/lerna version \
    --force-publish="*" \
    --preid "${tag}" \
    --no-git-tag-version \
    --no-push \
    --exact \
    --yes \
    "${bump}"
  distTag="${tag}"
fi

./node_modules/.bin/lerna exec \
  --no-private \
  --concurrency 1 \
  -- npm publish --tag "${distTag}" --access public --provenance

if [ "${tag}" != "public" ] ; then
    version=$(awk '/version/{gsub(/("|",)/,"",$2);print $2}' lerna.json)

    if [ "${tag}" == "beta" ] ; then
      git add .
      git commit -am "v${version}" --no-verify
      git push --set-upstream origin $(git branch --show-current) --no-verify
    fi
fi